---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustStrip from '@components/TrustStrip.astro';
import PujaProcess from '@components/PujaProcess.astro';
import Testimonials from '@components/Testimonials.astro';
import FAQ from '@components/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';
import { serviceSchema, faqSchema, breadcrumbSchema } from '@lib/schema';

/**
 * 2026-09-05 — RETARGETED. Measured, not guessed:
 * This page earned ZERO impressions across 84 days of GSC data (2026-06-04 → 09-02)
 * despite being indexed and internally linked from 50 of 51 pages. It is not starved
 * of links — 73% of its vocabulary also sits on the homepage, and its old title
 * ("Kaal Sarp Dosh Puja Ujjain — Vidvan Vaidik Pandit") targeted the exact head term
 * the homepage already owns. Google picked the homepage and suppressed this as a
 * near-duplicate.
 *
 * The homepage is deliberately NOT touched: it holds pos 14.9 on `kaal sarp dosh puja
 * ujjain` and is still climbing (26.1 → 14.8 over the last two 28-day windows). This
 * page carries zero traffic, so retargeting it risks nothing and is the only side of
 * the pair where there is upside.
 *
 * New target = the TRANSACTIONAL terms the homepage ranks for but loses:
 *   book kaal sarp dosh puja in ujjain        homepage pos 32.0
 *   best pandit for kaal sarp puja in ujjain  homepage pos 41.8
 *   kaal sarp dosh nivaran puja in ujjain     homepage pos 29.3 (14.3% CTR — real intent)
 * `निवारण पूजा` is kept in the H1 on purpose: commit 4d2db4a records a pos 2 → 25
 * regression caused by stripping exactly that service keyword. Do not remove it.
 */
const title = 'Book Kaal Sarp Dosh Nivaran Puja in Ujjain — Pandit Ji · ₹3,100 से';
const description = 'Ujjain mein Kaal Sarp Dosh Nivaran Puja online book karein — vidvan vaidik pandit ji dwara shastra-sammat vidhi. Naam-gotra se sankalp, HD video, prasad courier, NRI ke liye live option. ₹3,100 से, samagri sahit. Call: +91 9424002309';

const ksdFaqs = [
  {
    q: 'काल सर्प दोष क्या है?',
    a: 'वैदिक ज्योतिष के अनुसार, जब जन्म कुंडली के सभी ग्रह राहु और केतु के बीच आ जाते हैं, तब काल सर्प दोष माना जाता है। मान्यता है कि यह दोष जीवन में बाधाओं, मानसिक अशांति, करियर-स्वास्थ्य संबंधी अड़चनों और वंशवृद्धि में देरी का कारण बन सकता है। शास्त्रों में इसकी शांति हेतु विशेष वैदिक पूजा का विधान है।'
  },
  {
    q: 'काल सर्प दोष पूजा कहाँ करवानी चाहिए?',
    a: 'उज्जैन — महाकालेश्वर ज्योतिर्लिंग की नगरी और शिप्रा तट — को काल सर्प दोष शांति पूजा के लिए शास्त्र-सम्मत एवं अत्यंत प्रभावी स्थान माना गया है। यहीं पास में नागचंद्रेश्वर मंदिर भी स्थित है, जो वर्ष में एक बार नाग पंचमी पर ही खुलता है। मान्यता है कि उज्जैन में सम्पन्न पूजा का विशेष आध्यात्मिक फल मिलता है।'
  },
  {
    q: 'काल सर्प दोष पूजा का खर्च कितना है?',
    a: 'हमारी काल सर्प दोष शांति पूजा ₹3,100 से शुरू है — संकल्प, नाग-नागिन प्रतिमा (चांदी/पारद), मंत्र जाप (राहु-केतु बीज मंत्र), हवन, सम्पूर्ण पूजा सामग्री और दान-दक्षिणा सहित। 12 प्रकार के काल सर्प दोष (अनंत, कुलिक, वासुकि, शंखपाल, पद्म, महापद्म, तक्षक, कर्कोटक, शंखचूड़, घातक, विषधर, शेषनाग) के अनुसार सटीक विधि और मूल्य फोन पर बताया जाता है।'
  },
  {
    q: 'काल सर्प दोष पूजा का शुभ मुहूर्त क्या है?',
    a: 'काल सर्प दोष शांति पूजा के लिए सर्वोत्तम मुहूर्त: नाग पंचमी, श्रावण मास के सोमवार, अमावस्या, पंचमी तिथि, राहु काल के विपरीत समय। पंचांग के अनुसार आपके जन्म नक्षत्र देखकर पंडित जी सटीक मुहूर्त निर्धारित करते हैं।'
  },
  {
    q: 'पूजा कितनी देर चलती है?',
    a: 'सम्पूर्ण काल सर्प दोष शांति पूजा सामान्यतः 3 से 5 घंटे की होती है — संकल्प, गोत्र पूजा, राहु-केतु मंत्र जाप (कम-से-कम 1,008 बार), नाग-नागिन प्रतिमा पूजन, हवन और पूर्णाहुति। यजमान की उपस्थिति में या अनुपस्थिति में (ऑनलाइन वीडियो के साथ) सम्पन्न की जा सकती है।'
  },
  {
    q: 'क्या पूजा का वीडियो मिलता है?',
    a: 'हाँ। पूरी पूजा का HD वीडियो + संकल्प प्रमाणपत्र + प्रसाद / पवित्र जल यजमान को कुरियर द्वारा भेजा जाता है। NRI / दूरस्थ यजमानों के लिए लाइव वीडियो विकल्प भी उपलब्ध है।'
  },
  {
    q: 'क्या एक बार पूजा से सब ठीक हो जाएगा?',
    a: 'पूजा एक शास्त्र-सम्मत अनुष्ठान है — यह श्रद्धा, भक्ति और शांति की कामना से किया जाता है। मान्यता के अनुसार यह दोष की आध्यात्मिक शांति हेतु की जाती है। कुंडली के अनुसार पंडित जी कभी-कभी 3 बार (हर 6 या 12 महीने में) पूजा की सलाह देते हैं। हम कोई गारंटी या चमत्कारी दावा नहीं करते — शास्त्र विधि और श्रद्धा हमारा आधार है।'
  },
  {
    q: 'क्या उज्जैन आना ज़रूरी है?',
    a: 'नहीं। पूजा यजमान की उपस्थिति में या उनके नाम-गोत्र-संकल्प पर पंडित जी द्वारा सम्पन्न की जा सकती है। यजमान चाहें तो स्वयं उज्जैन पधारें (हम मंदिर दर्शन और रहने की जानकारी भी देते हैं), या घर बैठे संकल्प कर के पूजा करवा सकते हैं — दोनों विधियाँ शास्त्र-सम्मत हैं।'
  }
];

const schemas = [
  serviceSchema({
    name: 'Kaal Sarp Dosh Puja in Ujjain',
    nameHi: 'काल सर्प दोष पूजा उज्जैन',
    alternateNames: ['Kalsarp Dosh Nivaran Puja', 'Rahu-Ketu Shanti Puja', 'काल सर्प योग शांति'],
    description: 'Authentic Vedic Kaal Sarp Dosh Nivaran / Shanti Puja in Ujjain — 12 prakar ka Kaal Sarp Dosh anushthan, Shipra tat par Mahakal nagri mein.',
    slug: '/kaal-sarp-dosh-puja-in-ujjain/',
    price: SITE.pricing.starting
  }),
  faqSchema(ksdFaqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Our Pujas', url: '/our-pujas/' },
    { name: 'Kaal Sarp Dosh Puja', url: '/kaal-sarp-dosh-puja-in-ujjain/' }
  ])
];

const kaalSarpTypes = [
  { name: 'अनंत काल सर्प दोष', desc: '1st-7th भाव में राहु-केतु — मानसिक तनाव, साथी से अनबन' },
  { name: 'कुलिक काल सर्प दोष', desc: '2nd-8th भाव में राहु-केतु — आर्थिक और स्वास्थ्य बाधा' },
  { name: 'वासुकि काल सर्प दोष', desc: '3rd-9th भाव में राहु-केतु — भाई-बहन व भाग्य संबंधी' },
  { name: 'शंखपाल काल सर्प दोष', desc: '4th-10th भाव में राहु-केतु — माता व करियर बाधा' },
  { name: 'पद्म काल सर्प दोष', desc: '5th-11th भाव में राहु-केतु — संतान व विद्या बाधा' },
  { name: 'महापद्म काल सर्प दोष', desc: '6th-12th भाव में राहु-केतु — शत्रु व व्यय संबंधी' },
  { name: 'तक्षक काल सर्प दोष', desc: '7th-1st भाव में राहु-केतु — विवाह व साझेदारी बाधा' },
  { name: 'कर्कोटक काल सर्प दोष', desc: '8th-2nd भाव में राहु-केतु — आयु व कुटुंब बाधा' },
  { name: 'शंखचूड़ काल सर्प दोष', desc: '9th-3rd भाव में राहु-केतु — पिता व भाग्य बाधा' },
  { name: 'घातक काल सर्प दोष', desc: '10th-4th भाव में राहु-केतु — कर्म व यश बाधा' },
  { name: 'विषधर काल सर्प दोष', desc: '11th-5th भाव में राहु-केतु — लाभ व संतान बाधा' },
  { name: 'शेषनाग काल सर्प दोष', desc: '12th-6th भाव में राहु-केतु — व्यय व शत्रु बाधा' }
];

const inclusions = [
  'संकल्प + गोत्र पूजा',
  'राहु-केतु बीज मंत्र जाप (1,008+)',
  'नाग-नागिन चांदी प्रतिमा पूजन',
  'विधिवत हवन व पूर्णाहुति',
  'मंगल यंत्र / राहु यंत्र',
  'सम्पूर्ण पूजा सामग्री',
  'शुभ मुहूर्त निर्धारण',
  'पूजा HD वीडियो + प्रसाद',
  '12 प्रकार के दोष की पहचान',
  'पंडित जी से प्रत्यक्ष परामर्श'
];
---

<BaseLayout title={title} description={description} schemas={schemas} language="hi">
  <Hero
    h1="उज्जैन में काल सर्प दोष निवारण पूजा बुक करें — विद्वान वैदिक पंडित जी से"
    subtitle="महाकाल की नगरी उज्जैन में 12 प्रकार के काल सर्प दोष की शास्त्र-सम्मत शांति पूजा — बुकिंग से प्रसाद तक की पूरी प्रक्रिया नीचे दी गई है। उज्जैन आना अनिवार्य नहीं; नाम-गोत्र संकल्प से भी पूजा सम्पन्न होती है। ₹3,100 से, सामग्री सहित।"
    image="/images/hero-kaal-sarp.jpg"
    imageAlt="Kaal Sarp Dosh Puja in Ujjain — Vedic Pandit at Shipra Tat"
    trustBadges={['काल सर्प दोष पूजा उज्जैन', '15+ वर्ष अनुभव', '5,000+ परिवार', 'शिप्रा तट · महाकाल नगरी']}
  />

  <TrustStrip />

  <section class="py-16 bg-white">
    <div class="container-narrow prose-vedic">
      <h2>काल सर्प दोष क्या है?</h2>
      <p>
        वैदिक ज्योतिष के अनुसार, जब किसी की जन्म कुंडली के <strong>सभी ग्रह राहु और केतु के बीच</strong> आ जाते हैं, तब <strong>काल सर्प दोष / काल सर्प योग</strong> बनता है। मान्यता है कि यह दोष जीवन में मानसिक अशांति, करियर-स्वास्थ्य की अड़चनें, विवाह या वंशवृद्धि में देरी, और बार-बार सपनों में सर्प दिखाई देने जैसे अनुभवों का कारण बन सकता है।
      </p>
      <p>
        शास्त्रों में इसकी शांति हेतु <strong>राहु-केतु बीज मंत्र जाप, हवन और नाग-नागिन प्रतिमा पूजन</strong> का विधान है — यह कोई "इलाज" या चमत्कारी उपाय नहीं, बल्कि श्रद्धा से किया जाने वाला शास्त्र-सम्मत आध्यात्मिक अनुष्ठान है।
      </p>

      <h3>उज्जैन में काल सर्प दोष पूजा का महत्व</h3>
      <p>
        उज्जैन को <strong>महाकालेश्वर ज्योतिर्लिंग की नगरी</strong> कहा जाता है — यहीं पास में <strong>नागचंद्रेश्वर मंदिर</strong> स्थित है, जो वर्ष में केवल एक बार नाग पंचमी पर ही दर्शनार्थ खुलता है। शिप्रा नदी के तट पर सम्पन्न वैदिक अनुष्ठानों का प्राचीन काल से विशेष महत्व माना गया है। प्राचीन परंपरा में उज्जैन कर्क रेखा पर स्थित होने के कारण यहाँ ज्योतिषीय गणनाओं का केंद्र रहा है।
      </p>
    </div>
  </section>

  <section class="py-16 bg-cream-100">
    <div class="container-narrow">
      <h2 class="text-center mb-3">12 प्रकार के काल सर्प दोष</h2>
      <p class="text-center text-ink-700 mb-10 text-sm sm:text-base">
        कुंडली में राहु-केतु की स्थिति के अनुसार काल सर्प दोष 12 प्रकार का होता है। प्रत्येक के लिए विधि व मंत्र भिन्न हैं।
      </p>
      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {kaalSarpTypes.map((t) => (
          <li class="bg-white border border-gold-200 rounded-lg p-4">
            <div class="flex items-start gap-2">
              <Icon name="mdi:snake" class="w-5 h-5 text-saffron-600 shrink-0 mt-0.5" />
              <div>
                <strong class="block text-ink-900 text-sm">{t.name}</strong>
                <span class="text-xs text-ink-700 leading-snug">{t.desc}</span>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <p class="text-center text-xs text-ink-600 mt-6">
        विस्तृत जानकारी:&nbsp;
        <a href="/kaal-sarp-dosh-12-prakar/" class="text-saffron-700 underline">12 प्रकार के काल सर्प दोष — पूरी जानकारी</a>
      </p>
    </div>
  </section>

  <PujaProcess />

  <section class="py-16 bg-white">
    <div class="container-narrow">
      <h2 class="text-center mb-8">पूजा में क्या शामिल है</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {inclusions.map((f) => (
          <li class="flex items-start gap-2 bg-cream-50 border border-gold-200 rounded-lg p-3">
            <Icon name="mdi:check-decagram" class="w-5 h-5 text-saffron-600 shrink-0 mt-0.5" />
            <span class="text-sm text-ink-800">{f}</span>
          </li>
        ))}
      </ul>
      <div class="text-center mt-8 text-ink-700">
        <strong>मूल्य ₹3,100 से शुरू</strong> · कुंडली विश्लेषण के बाद सटीक मूल्य फोन पर
      </div>
    </div>
  </section>

  <section class="py-16 bg-white border-y border-gold-200">
    <div class="container-narrow prose-vedic">
      <h2>पूजा कैसे बुक करें — पूरी प्रक्रिया</h2>
      <p>
        उज्जैन में काल सर्प दोष निवारण पूजा बुक करने के लिए आपको उज्जैन आना अनिवार्य नहीं है।
        यजमान की उपस्थिति में और नाम-गोत्र संकल्प — दोनों विधियाँ शास्त्र-सम्मत हैं।
        नीचे पूरी प्रक्रिया दी गई है।
      </p>

      <ol class="list-decimal pl-5 space-y-3 mt-4">
        <li>
          <strong>पंडित जी से बात</strong> — <a href={SITE.phone.tel} data-source="booking-steps" class="text-saffron-700 underline">{SITE.phone.display}</a> पर
          कॉल करें। कुंडली में काल सर्प दोष है या नहीं, और 12 में से कौन-सा प्रकार है — यह पहले देखा जाता है।
        </li>
        <li>
          <strong>जन्म विवरण</strong> — यजमान का नाम, गोत्र, जन्म तिथि, जन्म समय और जन्म स्थान।
          गोत्र ज्ञात न हो तो <em>कश्यप</em> गोत्र से संकल्प कराया जाता है, जो शास्त्र-सम्मत है।
        </li>
        <li>
          <strong>मुहूर्त निर्धारण</strong> — आपके जन्म नक्षत्र और पंचांग के अनुसार पंडित जी तिथि तय करते हैं।
          अमावस्या, पंचमी और नाग पंचमी विशेष मानी जाती हैं।
        </li>
        <li>
          <strong>विधि और मूल्य तय</strong> — दोष के प्रकार के अनुसार विधि तय होती है।
          मूल्य ₹3,100 से आरम्भ; सटीक मूल्य कुंडली देखने के बाद फोन पर स्पष्ट बताया जाता है —
