---
import BaseLayout from '@layouts/BaseLayout.astro';
import TrustStrip from '@components/TrustStrip.astro';
import Testimonials from '@components/Testimonials.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';
import { breadcrumbSchema } from '@lib/schema';

const title = 'About Pandit Ji — Kaal Sarp Dosh Puja Ujjain | 15+ Years Experience';
const description = `Mangalnath Mandir Ujjain ke ${SITE.pandit.experience} varsh anubhavi vaidik pandit. ${SITE.pandit.familiesServed} parivaron ke liye Kaal Sarp Dosh, Mangal Dosh evam Mahamrityunjaya jaap sampann.`;
const schemas = [breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about-us/' }
])];
---

<BaseLayout title={title} description={description} schemas={schemas}>
  <section class="py-12 bg-gradient-to-br from-saffron-50 to-cream-100 border-b border-gold-200">
    <div class="container-wide text-center">
      <p class="badge-trust mb-3">हमारे बारे में</p>
      <h1>उज्जैन के मंगलनाथ मंदिर के विद्वान पंडित</h1>
      <p class="text-lg text-ink-700 mt-3 max-w-2xl mx-auto">{SITE.pandit.bioHi}</p>
    </div>
  </section>

  <TrustStrip />

  <section class="py-16 bg-white">
    <div class="container-wide grid lg:grid-cols-2 gap-10 items-center">
      <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-cta border-4 border-cream-50">
        <img src={SITE.pandit.photo} alt={`${SITE.pandit.name} performing Kaal Sarp Dosh Puja at Mangalnath Mandir Ujjain`} width="800" height="1000" loading="eager" class="w-full h-full object-cover" />
      </div>

      <div class="prose-vedic">
        <h2>परंपरा · अनुभव · विश्वास</h2>
        <p>
          हमारी सेवा का आधार है <strong>प्रामाणिक वैदिक परंपरा</strong>। पंडित जी ने अपने पिता एवं गुरुजनों से वर्षों तक सीखा है — संस्कृत मंत्र, पंचांग गणना, यज्ञ विधि, और पूजा संकल्प की पूरी प्रक्रिया।
        </p>
        <p>
          आज वे उज्जैन के <strong>मंगलनाथ मंदिर</strong> (मंगल देव की जन्मस्थली) में नियमित पूजा कराते हैं। पिछले {SITE.pandit.experience} वर्षों में उन्होंने <strong>{SITE.pandit.familiesServed} परिवारों</strong> के लिए काल सर्प दोष, मंगल दोष, महामृत्युंजय जाप, और रुद्राभिषेक जैसी पूजाएँ सम्पन्न कराई हैं।
        </p>

        <h3>हमारा वादा</h3>
        <ul>
          <li><strong>पारदर्शी मूल्य</strong> — कोई हिडन चार्ज नहीं, पूरा खर्च पहले ही बताया जाता है</li>
          <li><strong>शुद्ध मंत्र</strong> — संस्कृत उच्चारण पारंपरिक विधि से, कोई शॉर्टकट नहीं</li>
          <li><strong>पूरी पूजा सामग्री</strong> — हम arrange करते हैं, आपको कुछ नहीं लाना</li>
          <li><strong>शुभ मुहूर्त</strong> — आपकी कुंडली के अनुसार सटीक समय निकाला जाता है</li>
          <li><strong>पूजा के बाद follow-up</strong> — आपकी जिज्ञासाओं का समाधान</li>
        </ul>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="py-16 bg-cream-100">
    <div class="container-narrow text-center">
      <h2>क्या आपको काल सर्प दोष पूजा कराना चाहिए?</h2>
      <p class="text-ink-700 mt-3 mb-6 leading-relaxed">पंडित जी से सीधे बात करें — कुंडली देखकर बताएँगे कि कौनसा दोष है और कौनसी पूजा सही रहेगी।</p>
      <a href={SITE.phone.tel} data-source="about-cta" class="btn-call-lg">
        <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
        अभी कॉल करें · {SITE.phone.display}
      </a>
    </div>
  </section>
</BaseLayout>
