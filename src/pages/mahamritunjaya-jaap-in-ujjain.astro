---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustStrip from '@components/TrustStrip.astro';
import PujaProcess from '@components/PujaProcess.astro';
import Testimonials from '@components/Testimonials.astro';
import FAQ from '@components/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';
import { serviceSchema, faqSchema, breadcrumbSchema } from '@lib/schema';

const title = 'Mahamrityunjay Jaap in Ujjain | Mahakal ke Sheher Mein · ₹3,100 से';
const description = 'Mahakaleshwar Ujjain mein Mahamrityunjay Mantra Jaap vidvan pandit dwara — aarogya, aayu vriddhi, sankat nivaran. Sava Lakh / Sampoorna jaap available. Call: +91 9424002309';

const faqs = [
  { q: 'महामृत्युंजय जाप क्यों किया जाता है?', a: 'यह मंत्र भगवान शिव को समर्पित है और इसका जाप अकाल मृत्यु, रोग, संकट, और भय से मुक्ति के लिए किया जाता है। यह आयु वृद्धि, स्वास्थ्य लाभ, और मानसिक शांति के लिए सर्वोत्तम मंत्र माना गया है।' },
  { q: 'उज्जैन में महामृत्युंजय जाप क्यों कराएँ?', a: 'उज्जैन में महाकालेश्वर ज्योतिर्लिंग है — द्वादश ज्योतिर्लिंगों में सबसे अधिक फलदायी। यहाँ पर सम्पन्न जाप का विशेष महत्व माना गया है।' },
  { q: 'जाप कितने प्रकार के होते हैं?', a: 'मुख्य प्रकार — लघु जाप (1,100 बार), सम्पूर्ण जाप (1,25,000 / सवा लाख), और सम्पुटित जाप (3,25,000 / सवा तीन लाख)। आपकी समस्या के अनुसार पंडित जी सही जाप बताएँगे।' },
  { q: 'जाप का खर्च कितना आता है?', a: 'लघु जाप ₹3,100 से शुरू, सवा लाख जाप ₹11,000 से। पूरी सामग्री, हवन और दान-दक्षिणा सहित। फोन पर सटीक जानकारी मिलेगी।' }
];

const schemas = [
  serviceSchema({
    name: 'Mahamrityunjay Jaap in Ujjain',
    nameHi: 'महामृत्युंजय जाप उज्जैन',
    description: 'Vedic Mahamrityunjay Mantra Jaap at Mahakaleshwar / Mangalnath Mandir, Ujjain — health, longevity, sankat nivaran.',
    slug: '/mahamritunjaya-jaap-in-ujjain/',
    price: SITE.pricing.starting
  }),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Mahamrityunjay Jaap', url: '/mahamritunjaya-jaap-in-ujjain/' }
  ])
];
---

<BaseLayout title={title} description={description} schemas={schemas} language="hi">
  <Hero
    h1="उज्जैन में महामृत्युंजय जाप — महाकाल की नगरी से"
    subtitle="महाकालेश्वर ज्योतिर्लिंग के समीप वैदिक पंडित द्वारा सम्पन्न जाप — आरोग्य, आयु वृद्धि, संकट निवारण के लिए। सवा लाख जाप उपलब्ध।"
    image="/images/hero-mahamrityunjay.jpg"
    imageAlt="Mahamrityunjay Jaap at Mahakaleshwar Ujjain"
    trustBadges={['महाकालेश्वर', '15+ वर्ष', 'सवा लाख जाप', 'सिद्ध मंत्र']}
  />

  <TrustStrip />

  <section class="py-16 bg-white">
    <div class="container-narrow prose-vedic">
      <h2>महामृत्युंजय मंत्र</h2>
      <blockquote class="font-display text-maroon-900 text-xl !leading-relaxed text-center">
        ॥ ॐ त्र्यम्बकं यजामहे सुगन्धिं पुष्टिवर्धनम् ।<br />
        उर्वारुकमिव बन्धनान्मृत्योर्मुक्षीय माऽमृतात् ॥
      </blockquote>
      <p>
        यह ऋग्वेद का सबसे शक्तिशाली मंत्र माना गया है। इसकी रचना ऋषि मार्कण्डेय ने की थी जिन्होंने मृत्यु पर विजय प्राप्त की थी। नियमित जाप से असाध्य रोग, दुर्भाग्य, और जीवन के संकट दूर होते हैं।
      </p>
    </div>
  </section>

  <PujaProcess />

  <Testimonials />
  <FAQ items={faqs} title="महामृत्युंजय जाप — प्रश्नोत्तर" />

  <section class="py-16 bg-gradient-to-br from-maroon-800 to-maroon-900 text-cream-50">
    <div class="container-narrow text-center">
      <h2 class="!text-cream-50">महामृत्युंजय जाप बुक करें</h2>
      <p class="text-cream-200 mt-3">सही प्रकार का जाप पंडित जी आपकी समस्या के अनुसार बताएँगे।</p>
      <a href={SITE.phone.tel} data-source="mahamrityunjay-cta" class="btn-call-lg mt-6 bg-gold-500 hover:bg-gold-600 text-maroon-900">
        <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
        Call · {SITE.phone.display}
      </a>
    </div>
  </section>
</BaseLayout>
