---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@data/site';
import { breadcrumbSchema } from '@lib/schema';

const title = 'Terms of Service — Kaal Sarp Dosh Puja Ujjain';
const description = 'Terms governing the use of Kaal Sarp Dosh Puja Ujjain services and website. Please read before booking.';
const schemas = [breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Terms of Service', url: '/terms-of-service/' }
])];
---

<BaseLayout title={title} description={description} schemas={schemas}>
  <section class="py-12 bg-gradient-to-br from-saffron-50 to-cream-100 border-b border-gold-200">
    <div class="container-narrow text-center">
      <p class="badge-trust mb-3">Legal</p>
      <h1>Terms of Service</h1>
      <p class="text-ink-600 mt-2">Last updated: 2026-05-17</p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="container-narrow prose-vedic">
      <p>By using {SITE.url} or booking puja services through us, you agree to these terms.</p>

      <h2>1. Services Offered</h2>
      <p>We offer Vedic puja services in Ujjain, Madhya Pradesh, including but not limited to:</p>
      <ul>
        <li>Kaal Sarp Dosh Puja (12 types)</li>
        <li>Mangal Dosh / Manglik Dosh Nivaran Puja</li>
        <li>Mahamrityunjay Mantra Jaap</li>
        <li>Rudrabhishek, Pitra Dosh Puja, and other Vedic rituals</li>
      </ul>

      <h2>2. Booking</h2>
      <ul>
        <li>Bookings are made via phone call (<a href={SITE.phone.tel}>{SITE.phone.display}</a>)</li>
        <li>No advance payment required at the time of booking</li>
        <li>Final muhurat and date is confirmed by pandit ji after reviewing your kundli/birth details</li>
        <li>Payment is made on the day of the puja in cash, UPI, or bank transfer</li>
      </ul>

      <h2>3. Pricing</h2>
      <p>Our base puja pricing starts at <strong>₹{SITE.pricing.starting.toLocaleString('en-IN')}</strong> and is transparently shared on phone. Final cost may vary based on:</p>
      <ul>
        <li>Type and duration of puja (e.g. Sava Lakh jaap = ₹11,000+)</li>
        <li>Specific samagri requirements</li>
        <li>Custom dakshina (optional)</li>
      </ul>
      <p>All charges are communicated before the puja begins. No hidden fees.</p>

      <h2>4. Cancellation</h2>
      <ul>
        <li>You may cancel your booking up to 24 hours before the scheduled puja without penalty</li>
        <li>For cancellations less than 24 hours before, samagri arrangement charges (if already procured) may apply</li>
        <li>To cancel, call <a href={SITE.phone.tel}>{SITE.phone.display}</a></li>
      </ul>

      <h2>5. Service Standards</h2>
      <p>We commit to:</p>
      <ul>
        <li>Authentic Vedic rituals as per Sanskrit shastra</li>
        <li>Punctual arrival at the agreed muhurat</li>
        <li>Pure samagri (silver naag-nagin, pure ghee, fresh flowers, etc.)</li>
        <li>Sanskrit mantras pronounced correctly without shortcuts</li>
        <li>Video recording and prasad delivery post-puja</li>
      </ul>

      <h2>6. Religious Disclaimer</h2>
      <p>Our puja services are based on traditional Vedic shastra. We make no guarantees about outcomes. Results vary based on individual karma, faith, and circumstances. Please read our full <a href="/disclaimer/">Disclaimer</a>.</p>

      <h2>7. Use of Website</h2>
      <ul>
        <li>You may not copy, reproduce, or republish our content without permission</li>
        <li>Blog articles are for informational purposes only — not medical, legal, or financial advice</li>
        <li>You agree not to misuse the site, including spam, hacking, or unauthorized access</li>
      </ul>

      <h2>8. Limitation of Liability</h2>
      <p>To the maximum extent permitted by law, we are not liable for indirect, incidental, or consequential damages arising from your use of our services or website.</p>

      <h2>9. Governing Law</h2>
      <p>These terms are governed by the laws of India. Any disputes will be subject to the exclusive jurisdiction of the courts of Ujjain, Madhya Pradesh.</p>

      <h2>10. Contact</h2>
      <p>For questions about these terms, contact us at <a href={SITE.phone.tel}>{SITE.phone.display}</a> or visit our <a href="/contact-us/">Contact page</a>.</p>
    </div>
  </section>
</BaseLayout>
