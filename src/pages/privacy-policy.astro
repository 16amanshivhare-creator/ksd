---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@data/site';
import { breadcrumbSchema } from '@lib/schema';

const title = 'Privacy Policy — Kaal Sarp Dosh Puja Ujjain';
const description = 'Our privacy commitment for visitors and customers of Kaal Sarp Dosh Puja Ujjain. We do not share or sell your personal data.';
const schemas = [breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy-policy/' }
])];
const updated = '2026-05-17';
---

<BaseLayout title={title} description={description} schemas={schemas}>
  <section class="py-12 bg-gradient-to-br from-saffron-50 to-cream-100 border-b border-gold-200">
    <div class="container-narrow text-center">
      <p class="badge-trust mb-3">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="text-ink-600 mt-2">Last updated: {updated}</p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="container-narrow prose-vedic">
      <p>
        At <strong>Kaal Sarp Dosh Puja Ujjain</strong> ({SITE.url}), we respect your privacy. This Privacy Policy explains how we collect, use, and protect any information you share with us when booking puja services or contacting us.
      </p>

      <h2>1. Information We Collect</h2>
      <p>When you call or contact us for puja booking, we may collect:</p>
      <ul>
        <li>Your name, gotra, and date of birth (required for sankalp during puja)</li>
        <li>Phone number (for booking confirmation and follow-up)</li>
        <li>City/location (for muhurat calculation)</li>
        <li>Kundli details, if you choose to share them</li>
      </ul>
      <p>When you visit our website, we may automatically collect (via Google Analytics):</p>
      <ul>
        <li>Browser type, device, and operating system</li>
        <li>Pages visited, time spent, and referring source</li>
        <li>Anonymous, aggregated usage statistics</li>
      </ul>

      <h2>2. How We Use Your Information</h2>
      <ul>
        <li><strong>Puja booking & sankalp</strong> — your name and gotra are spoken during ritual</li>
        <li><strong>Communication</strong> — booking confirmation, muhurat reminders, post-puja follow-up</li>
        <li><strong>Service improvement</strong> — aggregated analytics to improve website experience</li>
        <li><strong>Compliance</strong> — fulfilling legal obligations under Indian law</li>
      </ul>

      <h2>3. What We Don't Do</h2>
      <ul>
        <li>We <strong>do not sell</strong> your personal information to third parties</li>
        <li>We <strong>do not share</strong> your kundli or birth details with anyone outside pandit ji</li>
        <li>We <strong>do not send</strong> spam or marketing calls</li>
        <li>We <strong>do not store</strong> payment card details on our server (we accept UPI/bank transfer directly)</li>
      </ul>

      <h2>4. Third-Party Services</h2>
      <p>Our website uses these services with limited data sharing:</p>
      <ul>
        <li><strong>Google Analytics & Google Ads</strong> — anonymized usage tracking (no personal data)</li>
        <li><strong>Cloudflare</strong> — website hosting and security (standard server logs only)</li>
      </ul>

      <h2>5. Cookies</h2>
      <p>We use minimal cookies — only for analytics. No tracking cookies, no advertising cookies beyond Google Ads conversion tracking. You can disable cookies in your browser at any time without affecting site functionality.</p>

      <h2>6. Your Rights</h2>
      <ul>
        <li>Request what data we hold about you</li>
        <li>Request correction or deletion of your data</li>
        <li>Withdraw consent for follow-up communication</li>
      </ul>
      <p>To exercise these rights, call us at <a href={SITE.phone.tel}>{SITE.phone.display}</a>.</p>

      <h2>7. Data Retention</h2>
      <p>We retain your booking information for 3 years for tax compliance, then it is permanently deleted. Kundli and birth details are kept only as long as needed for the puja and follow-up.</p>

      <h2>8. Children's Privacy</h2>
      <p>Our services are intended for adults. We do not knowingly collect data from individuals under 18.</p>

      <h2>9. Changes to This Policy</h2>
      <p>We may update this Privacy Policy occasionally. The "Last updated" date at the top will reflect any changes.</p>

      <h2>10. Contact</h2>
      <p>For any privacy-related questions, contact us at:</p>
      <ul>
        <li>Phone: <a href={SITE.phone.tel}>{SITE.phone.display}</a></li>
        <li>Address: {SITE.address.streetAddress}, {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}, India</li>
      </ul>
    </div>
  </section>
</BaseLayout>
