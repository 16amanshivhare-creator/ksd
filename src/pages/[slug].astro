---
import BaseLayout from '@layouts/BaseLayout.astro';
import FAQ from '@components/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { SITE } from '@data/site';
import { articleSchema, faqSchema, breadcrumbSchema } from '@lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

const formatDate = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const schemas = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    slug: `/${post.slug}/`,
    image: post.data.image,
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    author: post.data.author,
    language: post.data.language
  }),
  ...(post.data.faq && post.data.faq.length > 0 ? [faqSchema(post.data.faq)] : []),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Blog', url: '/our-blog/' },
    { name: post.data.title, url: `/${post.slug}/` }
  ])
];

// Internal-link funnel: KSD posts cross-link within the cluster; generic blog
// posts surface the KSD money cluster so their traffic + internal PageRank flow
// to the commercial pages instead of dead-ending in generic astrology content.
const _others = (await getCollection('blog', ({ data, slug: s }) => !data.draft && s !== post.slug));
const _ksd = _others.filter((p) => p.data.category === 'kaal-sarp-dosh')
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const _same = _others.filter((p) => p.data.category === post.data.category)
  .sort((a, b) => +b.data.pubDate - +a.data.pubDate);
const related = (post.data.category === 'kaal-sarp-dosh' ? _same : _ksd).slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  language={post.data.language}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  schemas={schemas}
>
  <article>
    <header class="py-10 bg-gradient-to-br from-saffron-50 to-cream-100 border-b border-gold-200">
      <div class="container-narrow">
        <nav class="flex items-center gap-2 text-xs text-ink-600 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-maroon-800">Home</a>
          <Icon name="mdi:chevron-right" class="w-3 h-3" />
          <a href="/our-blog/" class="hover:text-maroon-800">Blog</a>
          <Icon name="mdi:chevron-right" class="w-3 h-3" />
          <span class="text-maroon-800 font-semibold truncate">{post.data.title}</span>
        </nav>
        <p class="text-xs text-saffron-700 font-semibold uppercase tracking-wider mb-2">
          {post.data.category === 'kaal-sarp-dosh' ? 'काल सर्प दोष' : 'ब्लॉग'}
        </p>
        <h1 class="!leading-tight">{post.data.title}</h1>
        <div class="flex flex-wrap items-center gap-4 mt-4 text-sm text-ink-600">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="mdi:account" class="w-4 h-4" />
            {post.data.author}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="mdi:calendar" class="w-4 h-4" />
            {formatDate(post.data.pubDate)}
          </span>
        </div>
      </div>
    </header>

    {post.data.image && (
      <div class="container-narrow -mt-4 mb-8 px-4">
        <img src={post.data.image} alt={post.data.imageAlt || post.data.title} width="1200" height="675" class="w-full aspect-[16/9] object-cover rounded-xl shadow-cta" loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="container-narrow pb-12">
      <div class="prose-vedic">
        <Content />
      </div>
    </div>

    {post.data.faq && post.data.faq.length > 0 && (
      <FAQ items={post.data.faq} title="अक्सर पूछे जाने वाले प्रश्न" />
    )}
  </article>

  <!-- Inline CTA -->
  <section class="py-12 bg-gradient-to-br from-maroon-800 to-maroon-900 text-cream-50">
    <div class="container-narrow text-center">
      <h2 class="!text-cream-50 text-2xl md:text-3xl">पूजा या उपाय के बारे में जानना है?</h2>
      <p class="text-cream-200 mt-3">पंडित जी से सीधे बात करें — काल सर्प दोष पूजा उज्जैन</p>
      <a href={SITE.phone.tel} data-source="blog-inline-cta" class="btn-call-lg mt-5 bg-gold-500 hover:bg-gold-600 text-maroon-900">
        <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
        Call · {SITE.phone.display}
      </a>
      <p class="text-cream-200 text-sm mt-5">
        <a href="/" class="underline decoration-gold-400 underline-offset-4 hover:text-gold-300 font-semibold">काल सर्प दोष पूजा उज्जैन — बुकिंग, विधि व खर्च</a>
        <span class="mx-2 opacity-50">·</span>
        <a href="/our-pujas/" class="underline decoration-gold-400 underline-offset-4 hover:text-gold-300 font-semibold">सभी पूजाएँ देखें</a>
      </p>
    </div>
  </section>

  {related.length > 0 && (
    <section class="py-12 bg-cream-100">
      <div class="container-wide">
        <h2 class="text-center mb-8">{post.data.category === 'kaal-sarp-dosh' ? 'सम्बंधित लेख' : 'काल सर्प दोष पूजा — सम्बंधित जानकारी'}</h2>
        <div class="grid md:grid-cols-3 gap-5">
          {related.map((r) => (
            <a href={`/${r.slug}/`} class="block bg-white border border-gold-200 rounded-xl overflow-hidden shadow-soft hover:shadow-cta">
              {r.data.image && <div class="aspect-[16/10]"><img src={r.data.image} alt={r.data.imageAlt || r.data.title} class="w-full h-full object-cover" loading="lazy" /></div>}
              <div class="p-4">
                <h3 class="text-base !leading-snug !text-maroon-900">{r.data.title}</h3>
                <p class="text-xs text-ink-600 mt-2">{formatDate(r.data.pubDate)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
