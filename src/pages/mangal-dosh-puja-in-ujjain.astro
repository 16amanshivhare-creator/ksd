---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustStrip from '@components/TrustStrip.astro';
import PujaProcess from '@components/PujaProcess.astro';
import Testimonials from '@components/Testimonials.astro';
import FAQ from '@components/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';
import { serviceSchema, faqSchema, breadcrumbSchema } from '@lib/schema';

const title = 'Mangal Dosh Puja in Ujjain | Mangalnath Mandir Pandit · ₹3,100 से';
const description = 'Ujjain Mangalnath Mandir mein Mangal Dosh / Manglik Dosh nivaran puja vidvan pandit dwara. Vivah baadhayen door, 15+ varsh anubhav. Call: +91 9424002309';

const mangalFaqs = [
  { q: 'मंगल दोष क्या है?', a: 'जब कुंडली के 1, 4, 7, 8 या 12वें भाव में मंगल ग्रह स्थित हो, तब मंगल दोष / मांगलिक दोष बनता है। यह विवाह में देरी, वैवाहिक जीवन में अशांति, या दाम्पत्य कलह का कारण बन सकता है।' },
  { q: 'मंगल दोष की पूजा कहाँ करवानी चाहिए?', a: 'उज्जैन का मंगलनाथ मंदिर — जो भगवान मंगल देव की जन्मस्थली है — मंगल दोष निवारण के लिए सर्वोत्तम स्थान माना गया है। यहाँ शिप्रा तट पर सम्पन्न पूजा का विशेष फल मिलता है।' },
  { q: 'मंगल दोष पूजा का खर्च कितना है?', a: 'हमारी मंगल दोष पूजा ₹3,100 से शुरू है — संकल्प, मंत्र जाप, हवन, सभी सामग्री और दान-दक्षिणा सहित। कुंडली के अनुसार सटीक मूल्य फोन पर बताया जाता है।' },
  { q: 'क्या मंगल दोष पूजा विवाह से पहले होनी चाहिए?', a: 'हाँ। मांगलिक व्यक्ति को विवाह से पूर्व मंगल दोष निवारण पूजा कराने की वैदिक परंपरा है। इससे वैवाहिक जीवन में सुख-शांति बनी रहती है।' }
];

const schemas = [
  serviceSchema({
    name: 'Mangal Dosh Puja in Ujjain',
    nameHi: 'मंगल दोष पूजा उज्जैन',
    description: 'Authentic Vedic Mangal Dosh / Manglik Dosh Nivaran Puja at Mangalnath Mandir, Ujjain.',
    slug: '/mangal-dosh-puja-in-ujjain/',
    price: SITE.pricing.starting
  }),
  faqSchema(mangalFaqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Mangal Dosh Puja', url: '/mangal-dosh-puja-in-ujjain/' }
  ])
];
---

<BaseLayout title={title} description={description} schemas={schemas} language="hi">
  <Hero
    h1="उज्जैन में मंगल दोष पूजा — मंगलनाथ मंदिर के पंडित से"
    subtitle="मांगलिक दोष निवारण के लिए मंगल देव की जन्मस्थली पर वैदिक विधि से सम्पन्न पूजा। विवाह बाधाएँ दूर करें, ₹3,100 से।"
    image="/images/hero-mangal.jpg"
    imageAlt="Mangal Dosh Puja at Mangalnath Mandir, Ujjain"
    trustBadges={['मंगलनाथ मंदिर', '15+ वर्ष', 'मांगलिक नivaran', 'सहमुहूर्त']}
  />

  <TrustStrip />

  <section class="py-16 bg-white">
    <div class="container-narrow prose-vedic">
      <h2>मंगल दोष क्यों होता है?</h2>
      <p>
        वैदिक ज्योतिष के अनुसार, जब किसी की जन्म कुंडली के <strong>1, 4, 7, 8 या 12वें भाव</strong> में मंगल ग्रह स्थित होता है, तब वह व्यक्ति <strong>मांगलिक</strong> कहलाता है। मंगल का यह अशुभ प्रभाव विवाह में देरी, साथी से तालमेल की कमी, या वैवाहिक जीवन में अनबन का कारण बन सकता है।
      </p>
      <h3>उज्जैन का महत्व</h3>
      <p>
        उज्जैन में <strong>मंगलनाथ मंदिर</strong> — मंगल देव की जन्मस्थली — विश्व का एकमात्र ऐसा स्थान है जहाँ की पूजा सीधे मंगल देव से जुड़ी मानी जाती है। यहाँ पर सम्पन्न मंगल दोष निवारण पूजा का प्रभाव विशेष फलदायी होता है।
      </p>
    </div>
  </section>

  <PujaProcess />

  <section class="py-16 bg-cream-100">
    <div class="container-narrow">
      <h2 class="text-center mb-8">पूजा में क्या शामिल है</h2>
      <ul class="grid sm:grid-cols-2 gap-3">
        {[
          'संकल्प + गोत्र पूजा',
          'मंगल मंत्र जाप (108/1008)',
          'मंगल हवन',
          'चांदी की मूर्ति दान',
          'मसूर दाल का दान',
          'पूरी पूजा सामग्री',
          'शुभ मुहूर्त',
          'पूजा वीडियो + प्रसाद'
        ].map((f) => (
          <li class="flex items-start gap-2 bg-white border border-gold-200 rounded-lg p-3">
            <Icon name="mdi:check-decagram" class="w-5 h-5 text-saffron-600 shrink-0 mt-0.5" />
            <span class="text-sm text-ink-800">{f}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Testimonials />
  <FAQ items={mangalFaqs} title="मंगल दोष — प्रश्नोत्तर" />

  <section class="py-16 bg-gradient-to-br from-maroon-800 to-maroon-900 text-cream-50">
    <div class="container-narrow text-center">
      <h2 class="!text-cream-50">मांगलिक दोष पूजा बुक करें</h2>
      <p class="text-cream-200 mt-3">पंडित जी से सीधे बात — मुहूर्त + मूल्य की पूरी जानकारी।</p>
      <a href={SITE.phone.tel} data-source="mangal-cta" class="btn-call-lg mt-6 bg-gold-500 hover:bg-gold-600 text-maroon-900">
        <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
        Call · {SITE.phone.display}
      </a>
    </div>
  </section>
</BaseLayout>
