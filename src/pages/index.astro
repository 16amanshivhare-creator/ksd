---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustStrip from '@components/TrustStrip.astro';
import PujaProcess from '@components/PujaProcess.astro';
import KaalSarpTypes from '@components/KaalSarpTypes.astro';
import Pricing from '@components/Pricing.astro';
import Testimonials from '@components/Testimonials.astro';
import FAQ from '@components/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { SITE, PUJA_SERVICES } from '@data/site';
import { serviceSchema, faqSchema, breadcrumbSchema } from '@lib/schema';
import { getCollection } from 'astro:content';

const faqItems = (await getCollection('faqs')).map((f) => ({
  q: f.data.question,
  a: f.data.answer
}));

const title = 'काल सर्प दोष पूजा उज्जैन | Pandit Ji · ₹3,100 से · Call 9424002309';
const description = SITE.metaDescription;

const schemas = [
  serviceSchema({
    name: 'Kaal Sarp Dosh Puja in Ujjain',
    nameHi: 'काल सर्प दोष पूजा उज्जैन',
    description: 'Authentic Vedic Kaal Sarp Dosh Puja at Mangalnath Mandir, Ujjain. 12 prakar ka nivaran by experienced pandit.',
    slug: '/',
    price: SITE.pricing.starting
  }),
  faqSchema(faqItems),
  breadcrumbSchema([{ name: 'Home', url: '/' }])
];
---

<BaseLayout title={title} description={description} schemas={schemas} language="hi">
  <Hero
    h1="उज्जैन में काल सर्प दोष पूजा — प्रामाणिक वैदिक पंडित से"
    subtitle="मंगलनाथ मंदिर के विद्वान पंडित द्वारा 12 प्रकार के काल सर्प दोष का निवारण। शुभ मुहूर्त, पूरी पूजा सामग्री, पारदर्शी ₹3,100 से — 500+ परिवारों की संतुष्टि।"
    image="/images/hero-ksd.jpg"
    imageAlt="Kaal Sarp Dosh Puja at Mangalnath Mandir, Ujjain"
  />

  <TrustStrip />

  <!-- Intro / What is KSD -->
  <section class="py-16 bg-white">
    <div class="container-narrow">
      <header class="text-center mb-8">
        <p class="badge-trust mb-3">परिचय</p>
        <h2>काल सर्प दोष क्या है?</h2>
      </header>
      <div class="prose-vedic">
        <p>
          जब किसी व्यक्ति की कुंडली में सभी सात ग्रह — सूर्य, चंद्र, मंगल, बुध, गुरु, शुक्र और शनि — राहु और केतु के बीच आ जाते हैं, तब <strong>काल सर्प दोष</strong> बनता है। यह दोष जीवन में अनेक प्रकार की बाधाएँ ला सकता है — विवाह में देरी, संतान सुख में बाधा, आर्थिक उलझनें, बार-बार बीमारी, और मानसिक अशांति।
        </p>
        <p>
          वैदिक शास्त्रों के अनुसार <strong>उज्जैन</strong> — जो कर्क रेखा पर स्थित है और जहाँ महाकालेश्वर ज्योतिर्लिंग एवं मंगलनाथ मंदिर (मंगल देव की जन्मस्थली) है — काल सर्प दोष निवारण के लिए सर्वोत्तम स्थान माना गया है। शिप्रा तट पर वैदिक विधि से सम्पन्न पूजा का प्रभाव विशेष फलदायी होता है।
        </p>
      </div>
    </div>
  </section>

  <KaalSarpTypes />

  <PujaProcess />

  <Pricing />

  <!-- Other Pujas -->
  <section class="py-16 bg-cream-100">
    <div class="container-wide">
      <header class="text-center mb-10">
        <p class="badge-trust mb-3">अन्य सेवाएँ</p>
        <h2>उज्जैन में अन्य प्रमुख पूजाएँ</h2>
      </header>
      <div class="grid md:grid-cols-3 gap-5">
        {PUJA_SERVICES.map((p) => (
          <a href={p.slug} class="block group bg-white border border-gold-200 rounded-xl p-6 hover:border-saffron-400 hover:shadow-cta transition-all">
            <div class="w-12 h-12 rounded-full bg-saffron-100 text-saffron-700 flex items-center justify-center text-2xl mb-3">🕉️</div>
            <h3 class="!text-maroon-800 group-hover:!text-maroon-900 mb-1.5">{p.titleHi}</h3>
            <p class="text-xs text-ink-600 mb-2">{p.title}</p>
            <p class="text-sm text-ink-700 leading-relaxed">{p.short}</p>
            <p class="mt-3 text-saffron-700 font-semibold text-sm flex items-center gap-1">
              अधिक जानें <Icon name="mdi:arrow-right" class="w-4 h-4" />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <FAQ items={faqItems} />

  <!-- Final CTA -->
  <section class="py-16 bg-gradient-to-br from-maroon-800 to-maroon-900 text-cream-50">
    <div class="container-narrow text-center">
      <p class="badge-trust mb-4 bg-gold-200 text-gold-900">सहायता चाहिए?</p>
      <h2 class="!text-cream-50 !leading-tight">पंडित जी से सीधे बात करें</h2>
      <p class="text-cream-200 mt-3 text-lg">आपकी कुंडली के अनुसार सही पूजा और मुहूर्त जानें।<br />बिना किसी एडवांस के बुकिंग।</p>
      <a href={SITE.phone.tel} data-source="final-cta" class="btn-call-lg mt-6 bg-gold-500 hover:bg-gold-600 text-maroon-900">
        <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
        अभी कॉल करें · {SITE.phone.display}
      </a>
      <p class="text-xs text-cream-300 mt-4">समय: {SITE.hours.open} – {SITE.hours.close} · सोम–रवि</p>
    </div>
  </section>
</BaseLayout>
