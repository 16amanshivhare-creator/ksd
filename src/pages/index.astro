---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import TrustStrip from '@components/TrustStrip.astro';
import KeywordVariants from '@components/KeywordVariants.astro';
import Symptoms from '@components/Symptoms.astro';
import PujaProcess from '@components/PujaProcess.astro';
import KaalSarpDetails from '@components/KaalSarpDetails.astro';
import Muhurats from '@components/Muhurats.astro';
import NearMeBlock from '@components/NearMeBlock.astro';
import WhyUs from '@components/WhyUs.astro';
import Pricing from '@components/Pricing.astro';
import Testimonials from '@components/Testimonials.astro';
import FAQ from '@components/FAQ.astro';
import { Icon } from 'astro-icon/components';
import { SITE, PUJA_SERVICES } from '@data/site';
import { serviceSchema, faqSchema, breadcrumbSchema, howToSchema, reviewItemsToAggregate, reviewSchema, organizationSchema, webPageSchema, eventMuhuratSchema } from '@lib/schema';
import { getCollection } from 'astro:content';

const faqItems = (await getCollection('faqs')).map((f) => ({
  q: f.data.question,
  a: f.data.answer
}));

const reviews = (await getCollection('testimonials')).map((t) => t.data);
const aggRating = reviewItemsToAggregate(reviews);

const title = 'Kaal Sarp Dosh Puja Ujjain | काल सर्प दोष पूजा उज्जैन · ₹3,100 से · Call 9424002309';
const description = 'Kaal Sarp Dosh Puja Ujjain — vidvan vaidik pandit ji se 12 prakar ka nivaran. Online booking, sahi muhurat, paardarshi ₹3,100 onwards. Ujjain mein Kaal Sarp Dosh Nivaran Puja. Call: +91 9424002309';

const schemas = [
  serviceSchema({
    name: 'Kaal Sarp Dosh Puja Ujjain',
    nameHi: 'काल सर्प दोष पूजा उज्जैन',
    alternateNames: [
      'Kaal Sarp Dosh Nivaran Puja Ujjain',
      'Ujjain Kaal Sarp Dosh Puja',
      'Kaal Sarp Yog Nivaran Puja Ujjain',
      'Online Kaal Sarp Dosh Puja Booking Ujjain'
    ],
    description: 'Authentic Vedic Kaal Sarp Dosh Puja in Ujjain — 12 prakar ka nivaran by experienced pandit, Shipra tat. Online booking, transparent pricing.',
    slug: '/',
    price: SITE.pricing.starting
  }),
  faqSchema(faqItems),
  howToSchema(),
  organizationSchema(),
  webPageSchema({
    title: 'Kaal Sarp Dosh Puja Ujjain',
    description: 'Authentic Vedic Kaal Sarp Dosh Nivaran Puja in Ujjain — 12 prakar ka nivaran',
    slug: '/',
    speakable: ['h1', 'h2', '.prose-vedic p']
  }),
  breadcrumbSchema([{ name: 'Home', url: '/' }]),
  ...eventMuhuratSchema([
    { date: '2026-08-09', name: 'Nag Panchami', tithi: 'Shravan Shukla Panchami' },
    { date: '2026-08-04', name: 'Shravan Somvar', tithi: 'Shravan Maas Somvar' },
    { date: '2026-08-23', name: 'Shravan Amavasya', tithi: 'Pitru tarpan + KSD' },
    { date: '2026-09-22', name: 'Sarva Pitru Amavasya', tithi: 'Mahalaya Amavasya' }
  ]),
  ...(aggRating ? [aggRating] : []),
  ...reviewSchema(reviews)
];
---

<BaseLayout title={title} description={description} schemas={schemas} language="hi">
  <Hero
    h1="Kaal Sarp Dosh Puja Ujjain — विद्वान वैदिक पंडित जी से"
    subtitle="उज्जैन में काल सर्प दोष निवारण पूजा — 12 प्रकार का प्रामाणिक निवारण, सही मुहूर्त, ऑनलाइन बुकिंग, पारदर्शी ₹3,100 से। शिप्रा तट पर 5,000+ परिवारों की संतुष्टि।"
    image="/images/hero-ksd.jpg"
    imageAlt="Kaal Sarp Dosh Puja Ujjain — Vedic Pandit Ji"
    trustBadges={['Kaal Sarp Dosh Puja Ujjain', '15+ वर्ष अनुभव', '5,000+ परिवार', '5.0 ⭐ Google']}
  />

  <TrustStrip />

  <KeywordVariants />

  <!-- Intro / What is KSD -->
  <section class="py-16 bg-white">
    <div class="container-narrow">
      <header class="text-center mb-8">
        <p class="badge-trust mb-3">परिचय · Introduction</p>
        <h2>काल सर्प दोष क्या है — और उज्जैन क्यों? <span class="block text-xl text-saffron-700 font-display font-medium mt-1">What is Kaal Sarp Dosh — and Why Ujjain?</span></h2>
      </header>
      <div class="prose-vedic">
        <p lang="hi">
          जब किसी व्यक्ति की कुंडली में सभी सात ग्रह — <strong>सूर्य, चंद्र, मंगल, बुध, गुरु, शुक्र और शनि</strong> — राहु और केतु के बीच आ जाते हैं, तब <strong>काल सर्प दोष</strong> बनता है। यह दोष जीवन में अनेक प्रकार की बाधाएँ ला सकता है — विवाह में देरी, संतान सुख में बाधा, आर्थिक उलझनें, बार-बार बीमारी और मानसिक अशांति। कुंडली के अनुसार इसके <strong>12 प्रकार</strong> होते हैं।
        </p>
        <p lang="en" class="text-ink-700">
          <strong>Kaal Sarp Dosh</strong> is formed when all seven planets — Sun, Moon, Mars, Mercury, Jupiter, Venus, and Saturn — are positioned between Rahu and Ketu in your birth chart. This astrological yog can cause delays in marriage, child-related challenges, financial obstacles, recurring illness, and mental restlessness. There are <strong>12 distinct types of Kaal Sarp Dosh</strong>, each with specific remedies.
        </p>
        <p lang="hi">
          वैदिक शास्त्रों के अनुसार <strong>उज्जैन में काल सर्प दोष पूजा</strong> सर्वोत्तम मानी गई है। उज्जैन कर्क रेखा पर स्थित है और महाकालेश्वर ज्योतिर्लिंग की नगरी है — शिप्रा तट पर सम्पन्न <strong>काल सर्प दोष निवारण पूजा</strong> का प्रभाव विशेष फलदायी होता है।
        </p>
        <p lang="en" class="text-ink-700">
          Per Vedic shastra, <strong>Kaal Sarp Dosh Puja in Ujjain</strong> is considered the most powerful remedy. Ujjain lies on the Tropic of Cancer and is home to Mahakaleshwar Jyotirlinga (one of the 12 sacred Jyotirlingas of India). A Kaal Sarp Dosh Nivaran Puja performed in this sacred city holds special significance — sought by devotees from across India and abroad.
        </p>
        <p lang="hi">
          इसीलिए देश-विदेश से लोग <strong>उज्जैन में काल सर्प दोष पूजा</strong> करवाने आते हैं — UP, राजस्थान, बिहार, दिल्ली, मुंबई, बंगलूरू से अब तक <strong>5,000+ परिवार</strong> लाभ ले चुके हैं। NRI ग्राहक भी USA, UK, UAE, Singapore, Canada से सेवा ले चुके हैं।
        </p>
      </div>
    </div>
  </section>

  <Symptoms />

  <KaalSarpDetails />

  <Muhurats />

  <PujaProcess />

  <NearMeBlock />

  <WhyUs />

  <Pricing />

  <!-- Other Pujas -->
  <section class="py-16 bg-cream-100">
    <div class="container-wide">
      <header class="text-center mb-10">
        <p class="badge-trust mb-3">अन्य सेवाएँ</p>
        <h2>उज्जैन में अन्य प्रमुख पूजाएँ</h2>
      </header>
      <div class="grid md:grid-cols-3 gap-5">
        {PUJA_SERVICES.map((p) => (
          <a href={p.slug} class="block group bg-white border border-gold-200 rounded-xl p-6 hover:border-saffron-400 hover:shadow-cta transition-all">
            <div class="w-12 h-12 rounded-full bg-saffron-100 text-saffron-700 flex items-center justify-center text-2xl mb-3">🕉️</div>
            <h3 class="!text-maroon-800 group-hover:!text-maroon-900 mb-1.5">{p.titleHi}</h3>
            <p class="text-xs text-ink-600 mb-2">{p.title}</p>
            <p class="text-sm text-ink-700 leading-relaxed">{p.short}</p>
            <p class="mt-3 text-saffron-700 font-semibold text-sm flex items-center gap-1">
              अधिक जानें <Icon name="mdi:arrow-right" class="w-4 h-4" />
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Testimonials />

  <FAQ items={faqItems} />

  <!-- Final CTA -->
  <section class="py-16 bg-gradient-to-br from-maroon-800 to-maroon-900 text-cream-50">
    <div class="container-narrow text-center">
      <p class="badge-trust mb-4 bg-gold-200 text-gold-900">अभी बुक करें</p>
      <h2 class="!text-cream-50 !leading-tight">पंडित जी से सीधे बात करें — काल सर्प दोष पूजा उज्जैन</h2>
      <p class="text-cream-200 mt-3 text-lg">आपकी कुंडली के अनुसार सही पूजा और मुहूर्त जानें।<br />बिना किसी एडवांस के बुकिंग। ऑनलाइन + ऑफलाइन दोनों उपलब्ध।</p>
      <a href={SITE.phone.tel} data-source="final-cta" class="btn-call-lg mt-6 bg-gold-500 hover:bg-gold-600 text-maroon-900">
        <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
        अभी कॉल करें · {SITE.phone.display}
      </a>
      <p class="text-xs text-cream-300 mt-4">पंडित जी से सीधी बात · सोम–रवि · कोई एडवांस नहीं</p>
    </div>
  </section>
</BaseLayout>
