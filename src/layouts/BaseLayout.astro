---
import '@styles/global.css';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileCallBar from '@components/MobileCallBar.astro';
import { SITE, TRACKING } from '@data/site';
import { localBusinessSchema } from '@lib/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  language?: 'hi' | 'en' | 'mr';
  schemas?: object[];
  pubDate?: Date;
  updatedDate?: Date;
}

const props = Astro.props;
const allSchemas = [localBusinessSchema(), ...(props.schemas || [])];
---

<!DOCTYPE html>
<html lang={props.language === 'en' ? 'en-IN' : props.language === 'mr' ? 'mr-IN' : 'hi-IN'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#a32933" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Fonts: PERF OPTIMIZED — 4 weights only (was 11) + async load via media trick -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Noto+Sans+Devanagari:wght@400;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Noto+Sans+Devanagari:wght@400;700&display=swap"
      />
    </noscript>

    <!-- ============================================================== -->
    <!-- GOOGLE ADS CONVERSION — SOLE SOURCE (per Ads HANDOFF 2026-05-10) -->
    <!-- DO NOT add gtag('event','conversion') anywhere else.            -->
    <!-- Re-fire dedup via transaction_id.                                -->
    <!-- ============================================================== -->
    <script is:inline define:vars={{ ADS: TRACKING.adsId, GA: TRACKING.gaId, LABEL: TRACKING.callConvLabel, PREFIX: TRACKING.txnIdPrefix, PHONE: SITE.phone.raw }}>
      // PERF: gtag init only — no external JS load until first interaction
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;

      var ADS_VALID = ADS && ADS.indexOf('XXX') === -1;
      var GA_VALID  = GA  && GA.indexOf('XXX')  === -1;
      var LABEL_VALID = LABEL && LABEL.indexOf('XXX') === -1;

      // Lazy-load gtag.js only after user interacts (saves ~50 KB on initial LCP)
      var gtagLoaded = false;
      function loadGtag() {
        if (gtagLoaded) return;
        gtagLoaded = true;
        var tagId = ADS_VALID ? ADS : (GA_VALID ? GA : null);
        if (!tagId) return;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + tagId;
        document.head.appendChild(s);
        gtag('js', new Date());
        if (GA_VALID)  gtag('config', GA,  { send_page_view: true });
        if (ADS_VALID) gtag('config', ADS);
      }
      // Load gtag on first interaction (click/scroll/touch) — Google's recommended LCP optimization
      ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function(ev){
        window.addEventListener(ev, loadGtag, { once: true, passive: true });
      });
      // Failsafe: load after 3s idle if no interaction
      setTimeout(loadGtag, 3000);

      window.__ksdFireCallConv = function () {
        if (!LABEL_VALID) return;
        var txn = PREFIX + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        gtag('event', 'conversion', {
          send_to: ADS + '/' + LABEL,
          transaction_id: txn
        });
        try { sessionStorage.setItem('ksd_last_conv', txn); } catch (e) {}
      };

      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (!a) return;
        if (a.dataset.tracked === '1') return;
        a.dataset.tracked = '1';
        setTimeout(function(){ a.dataset.tracked = '0'; }, 30000);
        loadGtag();
        window.__ksdFireCallConv();
        gtag('event', 'phone_call', {
          phone_number: PHONE,
          source: a.dataset.source || 'unknown'
        });
      }, { passive: true });

      // PERF: rAF-throttled scroll depth (was firing on EVERY scroll event = main-thread killer)
      var marks = [25, 50, 75, 100], fired = {}, scrollTicking = false;
      function checkDepth() {
        var h = document.documentElement;
        var pct = Math.round(((h.scrollTop + window.innerHeight) / h.scrollHeight) * 100);
        marks.forEach(function (m) {
          if (pct >= m && !fired[m]) {
            fired[m] = true;
            gtag('event', 'scroll_depth', { percent: m });
          }
        });
        scrollTicking = false;
      }
      window.addEventListener('scroll', function () {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(checkDepth);
      }, { passive: true });
    </script>

    <!-- LCP image preload (home only) — WebP first (124 KB vs JPG 160 KB) -->
    {Astro.url.pathname === '/' && (
      <link rel="preload" as="image" href="/images/hero-ksd.webp" type="image/webp" fetchpriority="high" />
    )}

    <SEO {...props} schemas={allSchemas} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-maroon-700 focus:text-white focus:px-4 focus:py-2 focus:rounded">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <MobileCallBar />
  </body>
</html>
