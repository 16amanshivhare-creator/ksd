---
import '@styles/global.css';
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import MobileCallBar from '@components/MobileCallBar.astro';
import { SITE, TRACKING } from '@data/site';
import { localBusinessSchema } from '@lib/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  language?: 'hi' | 'en' | 'mr';
  schemas?: object[];
  pubDate?: Date;
  updatedDate?: Date;
}

const props = Astro.props;
const allSchemas = [localBusinessSchema(), ...(props.schemas || [])];
---

<!DOCTYPE html>
<html lang={props.language === 'en' ? 'en-IN' : props.language === 'mr' ? 'mr-IN' : 'hi-IN'} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#a32933" />
    <meta name="format-detection" content="telephone=yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Fonts: Devanagari + Inter, preloaded -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <!-- ============================================================== -->
    <!-- GOOGLE ADS CONVERSION — SOLE SOURCE (per Ads HANDOFF 2026-05-10) -->
    <!-- DO NOT add gtag('event','conversion') anywhere else.            -->
    <!-- Re-fire dedup via transaction_id.                                -->
    <!-- ============================================================== -->
    <script is:inline define:vars={{ ADS: TRACKING.adsId, GA: TRACKING.gaId, LABEL: TRACKING.callConvLabel, PREFIX: TRACKING.txnIdPrefix, PHONE: SITE.phone.raw }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA, { send_page_view: true });
      if (ADS && ADS.indexOf('XXX') === -1) gtag('config', ADS);

      window.__ksdFireCallConv = function () {
        if (!LABEL || LABEL.indexOf('XXX') !== -1) return;
        var txn = PREFIX + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        gtag('event', 'conversion', {
          send_to: ADS + '/' + LABEL,
          transaction_id: txn
        });
        try { sessionStorage.setItem('ksd_last_conv', txn); } catch (e) {}
      };

      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="tel:"]');
        if (!a) return;
        if (a.dataset.tracked === '1') return;
        a.dataset.tracked = '1';
        setTimeout(function(){ a.dataset.tracked = '0'; }, 30000);
        window.__ksdFireCallConv();
        gtag('event', 'phone_call', {
          phone_number: PHONE,
          source: a.dataset.source || 'unknown'
        });
      }, { passive: true });
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${TRACKING.gaId}`}></script>

    <SEO {...props} schemas={allSchemas} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-maroon-700 focus:text-white focus:px-4 focus:py-2 focus:rounded">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <MobileCallBar />
  </body>
</html>
