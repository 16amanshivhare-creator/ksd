---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
}
const { items, title = 'अक्सर पूछे जाने वाले प्रश्न' } = Astro.props;
---

{items.length > 0 && (
  <section class="py-16 bg-cream-50">
    <div class="container-narrow">
      <header class="text-center mb-8">
        <p class="badge-trust mb-3">FAQ</p>
        <h2>{title}</h2>
      </header>

      <div class="space-y-3">
        {items.map((item, i) => (
          <details class="group bg-white border border-gold-200 rounded-lg overflow-hidden shadow-soft" open={i === 0}>
            <summary class="flex items-start justify-between gap-3 p-4 cursor-pointer list-none hover:bg-saffron-50 transition-colors">
              <h3 class="text-base md:text-lg !text-maroon-900 !leading-snug font-semibold pr-4 m-0">{item.q}</h3>
              <span class="shrink-0 w-6 h-6 rounded-full bg-saffron-100 text-saffron-700 flex items-center justify-center font-bold transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="p-4 pt-0 text-ink-700 leading-relaxed border-t border-gold-100" set:html={item.a}></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
