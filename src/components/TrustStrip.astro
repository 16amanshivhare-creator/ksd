---
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';

const items = [
  { icon: 'mdi:om', label: 'काल सर्प दोष विशेषज्ञ', sub: 'उज्जैन · वैदिक पंडित' },
  { icon: 'mdi:account-group', label: `${SITE.pandit.familiesServed} परिवार`, sub: 'सम्पन्न पूजाएँ' },
  // 2026-08-18 (ksd-011): the visible "5.0 ⭐ Google / 145+ रिव्यू" badge was removed along with the
  // JSON-LD aggregateRating. The 145 is hardcoded, unverifiable (the puja GMB listings are not in the
  // ByteFlow GBP account), and is the IDENTICAL number mangaldoshnivaranpujaujjain.com shows for a
  // different business at a different address. Removing the machine-readable claim while leaving the
  // visible one would still be the same unverifiable claim. Replaced with a fact we can stand behind.
  // To restore a rating here, put a REAL verified count in SITE.gmb and restore both halves together.
  { icon: 'mdi:map-marker', label: 'मंगलनाथ · उज्जैन', sub: 'शास्त्रोक्त विधि से पूजा' },
  { icon: 'mdi:certificate', label: '15+ वर्षों का अनुभव', sub: 'प्रामाणिक वैदिक विधि' }
];
---

<section class="bg-cream-100 border-y border-gold-200">
  <div class="container-wide py-6 grid grid-cols-2 md:grid-cols-4 gap-4">
    {items.map((it) => (
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-full bg-saffron-100 text-saffron-700 flex items-center justify-center shrink-0">
          <Icon name={it.icon} class="w-6 h-6" />
        </div>
        <div class="leading-tight">
          <p class="font-semibold text-maroon-900 text-sm md:text-base">{it.label}</p>
          <p class="text-xs text-ink-600">{it.sub}</p>
        </div>
      </div>
    ))}
  </div>
</section>
