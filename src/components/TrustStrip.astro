---
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';

const items = [
  { icon: 'mdi:om', label: 'काल सर्प दोष विशेषज्ञ', sub: 'उज्जैन · वैदिक पंडित' },
  { icon: 'mdi:account-group', label: `${SITE.pandit.familiesServed} परिवार`, sub: 'सम्पन्न पूजाएँ' },
  { icon: 'mdi:star', label: `${SITE.gmb.rating} ⭐ Google`, sub: `${SITE.gmb.reviewCount}+ रिव्यू` },
  { icon: 'mdi:certificate', label: '15+ वर्षों का अनुभव', sub: 'प्रामाणिक वैदिक विधि' }
];
---

<section class="bg-cream-100 border-y border-gold-200">
  <div class="container-wide py-6 grid grid-cols-2 md:grid-cols-4 gap-4">
    {items.map((it) => (
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-full bg-saffron-100 text-saffron-700 flex items-center justify-center shrink-0">
          <Icon name={it.icon} class="w-6 h-6" />
        </div>
        <div class="leading-tight">
          <p class="font-semibold text-maroon-900 text-sm md:text-base">{it.label}</p>
          <p class="text-xs text-ink-600">{it.sub}</p>
        </div>
      </div>
    ))}
  </div>
</section>
