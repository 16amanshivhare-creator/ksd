---
import { Icon } from 'astro-icon/components';
import { SITE, NAV_PRIMARY, PUJA_SERVICES } from '@data/site';
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-maroon-900 text-cream-100">
  <div class="container-wide py-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div class="space-y-3">
      <div class="flex items-center gap-2.5">
        <span class="w-10 h-10 rounded-full bg-gradient-to-br from-saffron-400 to-saffron-700 flex items-center justify-center text-white font-display font-bold">ॐ</span>
        <span class="font-display font-bold text-lg text-cream-50">काल सर्प दोष पूजा</span>
      </div>
      <p class="text-sm text-cream-200 leading-relaxed">
        <strong class="text-cream-50">काल सर्प दोष पूजा उज्जैन</strong> — विद्वान वैदिक पंडित द्वारा शास्त्र-सम्मत विधि से 12 प्रकार के कालसर्प दोष की शांति पूजा। शिप्रा तट · महाकाल की नगरी।
      </p>
      <p class="text-xs text-cream-300">15+ वर्ष अनुभव · 5,000+ परिवार</p>
      <p class="text-xs text-cream-300 leading-relaxed pt-1">
        उज्जैन आने वाले श्रद्धालुओं के लिए —
        <a href="https://ujjaintemple.com/simhastha-2028/" target="_blank" rel="noopener" class="text-saffron-300 hover:text-gold-300 underline decoration-dotted underline-offset-2">उज्जैन सिंहस्थ 2028 गाइड</a>
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-300 mb-3">पृष्ठ</h3>
      <ul class="space-y-2">
        {NAV_PRIMARY.map((it) => (
          <li><a href={it.href} class="text-sm text-cream-200 hover:text-saffron-300">{it.labelHi}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Puja services">
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-300 mb-3">पूजाएँ</h3>
      <ul class="space-y-2">
        {PUJA_SERVICES.map((p) => (
          <li><a href={p.slug} class="text-sm text-cream-200 hover:text-saffron-300">{p.titleHi}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-gold-300 mb-3">सम्पर्क</h3>
      <a href={SITE.phone.tel} data-source="footer" class="flex items-center gap-2 text-cream-100 hover:text-saffron-300 mb-3">
        <Icon name="mdi:phone" class="w-5 h-5" />
        <span class="font-mono">{SITE.phone.display}</span>
      </a>
      <address class="not-italic text-sm text-cream-200 leading-relaxed">
        {SITE.address.locality}, {SITE.address.region}<br />
        <a href={SITE.gmb.profileUrl} target="_blank" rel="noopener noreferrer" class="text-saffron-300 hover:text-gold-300 text-xs inline-flex items-center gap-1 mt-1">
          <Icon name="mdi:map-marker" class="w-3.5 h-3.5" /> Google Maps पर देखें
        </a>
      </address>
    </div>
  </div>

  <div class="border-t border-maroon-800">
    <div class="container-wide py-5 grid gap-3 md:grid-cols-3 items-center text-xs text-cream-300">
      <p>© {year} {SITE.name} · सर्वाधिकार सुरक्षित</p>
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1" aria-label="Legal">
        <a href="/privacy-policy/" class="hover:text-saffron-300">Privacy Policy</a>
        <a href="/terms-of-service/" class="hover:text-saffron-300">Terms</a>
        <a href="/refund-policy/" class="hover:text-saffron-300">Refund</a>
        <a href="/disclaimer/" class="hover:text-saffron-300">Disclaimer</a>
      </nav>
      <p class="md:text-right">Website by <a href="https://byteflowtech.in" target="_blank" rel="noopener" class="hover:text-saffron-300 underline decoration-dotted underline-offset-2">ByteFlow Technologies Pvt Ltd</a></p>
    </div>
  </div>
</footer>
