---
import { Icon } from 'astro-icon/components';
import { SITE } from '@data/site';

interface Props {
  h1: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  primary?: { label: string; href: string };
  trustBadges?: string[];
}

const {
  h1,
  subtitle,
  image = '/images/hero-default.jpg',
  imageAlt = 'Kaal Sarp Dosh Puja Ujjain — Vedic Pandit Ji',
  primary = { label: 'अभी कॉल करें', href: SITE.phone.tel },
  trustBadges = ['Kaal Sarp Dosh Puja Ujjain', '15+ Years Experience', '5,000+ Families', '5.0 ⭐ Google']
} = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-saffron-50 via-cream-100 to-saffron-100 border-b border-gold-200">
  <div class="absolute inset-0 opacity-[0.04] bg-[url('/textures/mandala-soft.svg')] bg-center bg-no-repeat bg-[length:600px]" aria-hidden="true"></div>

  <div class="container-wide relative grid lg:grid-cols-2 gap-8 lg:gap-12 py-10 md:py-16 items-center">
    <div class="space-y-6">
      <div class="flex flex-wrap gap-2">
        {trustBadges.map((b) => <span class="badge-trust">{b}</span>)}
      </div>

      <h1 class="!leading-tight">{h1}</h1>

      {subtitle && <p class="text-lg md:text-xl text-ink-700 leading-relaxed max-w-xl">{subtitle}</p>}

      <div class="flex flex-wrap gap-3 pt-2">
        <a href={primary.href} data-source="hero-primary" class="btn-call-lg">
          <Icon name="mdi:phone-in-talk" class="w-6 h-6" />
          <span>{primary.label}</span>
          <span class="font-mono hidden sm:inline">· {SITE.phone.display}</span>
        </a>
        <a href="#process" class="btn-ghost">
          <Icon name="mdi:format-list-checks" class="w-5 h-5" />
          पूजा प्रक्रिया देखें
        </a>
      </div>

      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 pt-3 text-sm text-ink-700">
        <li class="flex items-center gap-1.5"><Icon name="mdi:check-circle" class="w-4 h-4 text-saffron-600 shrink-0" /> प्रामाणिक वैदिक विधि</li>
        <li class="flex items-center gap-1.5"><Icon name="mdi:check-circle" class="w-4 h-4 text-saffron-600 shrink-0" /> 12 प्रकार का निवारण</li>
        <li class="flex items-center gap-1.5"><Icon name="mdi:check-circle" class="w-4 h-4 text-saffron-600 shrink-0" /> सही मुहूर्त</li>
        <li class="flex items-center gap-1.5"><Icon name="mdi:check-circle" class="w-4 h-4 text-saffron-600 shrink-0" /> ₹{SITE.pricing.starting.toLocaleString('en-IN')} से · सामग्री सहित</li>
      </ul>
    </div>

    <div class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] rounded-2xl overflow-hidden shadow-cta border-4 border-cream-50">
      <picture>
        <source srcset={image.replace(/\.(jpg|jpeg|png)$/, '.webp')} type="image/webp" />
        <img
          src={image}
          alt={imageAlt}
          width="800"
          height="1000"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </picture>
      <div class="absolute bottom-3 left-3 right-3 bg-cream-50/95 backdrop-blur rounded-lg p-3 flex items-center gap-3 shadow-soft">
        <div class="text-2xl">🪔</div>
        <div class="text-xs leading-tight">
          <p class="font-semibold text-maroon-900">काल सर्प दोष पूजा उज्जैन</p>
          <p class="text-ink-600">शिप्रा तट · महाकाल की नगरी · वैदिक विधि</p>
        </div>
      </div>
    </div>
  </div>
</section>
