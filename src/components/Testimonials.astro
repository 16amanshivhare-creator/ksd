---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const all = await getCollection('testimonials');
const items = all
  .map((t) => t.data)
  .sort((a, b) => +b.date - +a.date)
  .slice(0, 6);
---

{items.length > 0 && (
  <section class="py-16 bg-gradient-to-b from-cream-50 to-saffron-50">
    <div class="container-wide">
      <header class="text-center max-w-2xl mx-auto mb-10">
        <p class="badge-trust mb-3">परिवारों का अनुभव</p>
        <h2>500+ परिवारों ने करवाई पूजा</h2>
        <p class="text-ink-600 mt-2">असली ग्राहकों के अनुभव</p>
      </header>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {items.map((t) => (
          <article class="bg-white border border-gold-200 rounded-xl p-5 shadow-soft">
            <div class="flex gap-0.5 text-gold-500 mb-2">
              {Array.from({ length: t.rating }).map(() => <Icon name="mdi:star" class="w-5 h-5" />)}
            </div>
            <blockquote class="text-ink-800 leading-relaxed text-sm italic mb-3">"{t.quote}"</blockquote>
            <footer class="flex items-center gap-2.5 text-sm">
              <div class="w-9 h-9 rounded-full bg-maroon-100 text-maroon-800 flex items-center justify-center font-display font-bold">{t.name.charAt(0)}</div>
              <div class="leading-tight">
                <p class="font-semibold text-maroon-900">{t.name}</p>
                <p class="text-xs text-ink-600">{t.city}{t.pujaType ? ` · ${t.pujaType}` : ''}</p>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
