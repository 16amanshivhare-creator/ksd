---
const types = [
  { n: 1, name: 'Anant Kaal Sarp Dosh', nameHi: 'अनंत काल सर्प दोष', placement: 'राहु — प्रथम भाव, केतु — सप्तम भाव', effect: 'विवाह में देरी, साझेदारी में दिक्कत, अहं का टकराव। रिश्तों पर गहरा प्रभाव।' },
  { n: 2, name: 'Kulik Kaal Sarp Dosh', nameHi: 'कुलिक काल सर्प दोष', placement: 'राहु — द्वितीय भाव, केतु — अष्टम भाव', effect: 'पारिवारिक कलह, वाणी संबंधी समस्याएँ, अचानक धन हानि।' },
  { n: 3, name: 'Vasuki Kaal Sarp Dosh', nameHi: 'वासुकी काल सर्प दोष', placement: 'राहु — तृतीय भाव, केतु — नवम भाव', effect: 'भाई-बहन से मतभेद, साहस की कमी, पिता या गुरु से तनाव।' },
  { n: 4, name: 'Shankhapal Kaal Sarp Dosh', nameHi: 'शंखपाल काल सर्प दोष', placement: 'राहु — चतुर्थ भाव, केतु — दशम भाव', effect: 'घरेलू अशांति, सम्पत्ति विवाद, करियर में ठहराव, माता का स्वास्थ्य।' },
  { n: 5, name: 'Padma Kaal Sarp Dosh', nameHi: 'पद्म काल सर्प दोष', placement: 'राहु — पंचम भाव, केतु — एकादश भाव', effect: 'शिक्षा में बाधा, संतान संबंधी समस्या, प्रेम में निराशा।' },
