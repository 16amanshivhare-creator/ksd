  { n: 9, name: 'Shankhachud Kaal Sarp Dosh', nameHi: 'शंखचूड़ काल सर्प दोष', placement: 'राहु — नवम भाव, केतु — तृतीय भाव', effect: 'धर्म पर संदेह, पिता से समस्या, लंबी यात्राओं में बाधा।' },
  { n: 10, name: 'Ghatak Kaal Sarp Dosh', nameHi: 'घातक काल सर्प दोष', placement: 'राहु — दशम भाव, केतु — चतुर्थ भाव', effect: 'करियर में बाधा, व्यवसायिक असफलता, उच्च अधिकारियों से तनाव।' },
