  { n: 7, name: 'Takshak Kaal Sarp Dosh', nameHi: 'तक्षक काल सर्प दोष', placement: 'राहु — सप्तम भाव, केतु — प्रथम भाव', effect: 'दाम्पत्य कलह, साझेदारी में असफलता, आत्म-विश्वास की कमी।' },
